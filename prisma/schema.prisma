generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique @default("default@replayjournal.local")
  name      String    @default("Default Trader")
  createdAt DateTime  @default(now())
  sessions  Session[]
}

model Session {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  instrument      String
  periodStart     DateTime
  periodEnd       DateTime
  startingBalance Float
  status          String   @default("active") // "active" | "completed" | "archived"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  trades          Trade[]

  @@index([userId])
}

model Trade {
  // Core fields
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  symbol     String
  direction  String   // "long" | "short"
  entryAt    DateTime // Real time, not date-only
  exitAt     DateTime
  entryPrice Float
  exitPrice  Float
  grossPnl   Float
  result     String   // "win" | "loss" | "breakeven"
  notes      String?
  createdAt  DateTime @default(now())

  // Backtest-log fields (plain scalar columns)
  htfBias        String?  // "Bullish" | "Bearish" | "Neutral"
  newsToday      String?  // e.g. "NFP", "CPI", or blank
  riskPercent    Float?   // e.g. 1.0 (1%)
  drawDirection  String?  // e.g. "IRL -> ERL"
  setupModel     String?  // e.g. "LTF Sweep, 5m BOS, 5m FVG"
  emotionalState String?  // e.g. "Calm, Neutral"
  rulesFollowed  Boolean? // e.g. true / false
  rr             String?  // e.g. "1:3"

  @@index([sessionId])
}
